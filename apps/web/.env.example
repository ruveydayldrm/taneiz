# --- Veritabanı (Postgres'e geçmek için: provider = "postgresql" ve bu URL) ---
DATABASE_URL="file:./dev.db"

# --- Kimlik ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="taneiz-demo-secret-degistirin"

# --- QR kodlarına yazılan kök adres. Telefonla okutmak için bilgisayarın LAN IP'si:
# PUBLIC_BASE_URL="http://192.168.1.20:3000"

# --- AI servisi ---
AI_SERVICE_URL="http://127.0.0.1:8000"

# --- Blokzincir ---
# localhost (Hardhat node) veya amoy
CHAIN_NETWORK="localhost"
RPC_URL="http://127.0.0.1:8545"
# Boşsa ../../contracts/deployments/<CHAIN_NETWORK>.json okunur
# REGISTRY_ADDRESS="0x..."
# Hardhat #0 hesabının herkesçe bilinen anahtarı — SADECE yerel ağ için!
RELAYER_PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"

# --- Demo ---
# true iken ADMIN /demo/kurcala sayfasını kullanabilir
DEMO_MODE="true"
# Zincir kuyruğu işleyicisini web sunucusu içinde çalıştır (off ile kapatılır)
CHAIN_WORKER="on"
